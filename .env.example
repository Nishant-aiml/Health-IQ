# Application Settings
APP_NAME="AI Health Intelligence Platform"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_STR=/api/v1

# Database Configuration
DATABASE_URL=sqlite:///./health_companion.db

# Security & CORS Settings
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Centralized Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Future AI Service Placeholders (For subsequent phases)
SARVAM_API_KEY=
GLM_API_KEY=
